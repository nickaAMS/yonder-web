{
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/blog/why-i-built-yonder.html",
      "destination": "/blog/why-i-built-namesake.html",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/s/:token/cover",
      "destination": "/api/shared-story?token=:token&asset=cover"
    },
    {
      "source": "/s/:token",
      "destination": "/api/shared-story?token=:token"
    },
    {
      "source": "/download",
      "destination": "/download.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
