{
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/s/:token/cover",
      "destination": "/api/shared-story?token=:token&asset=cover"
    },
    {
      "source": "/s/:token",
      "destination": "/api/shared-story?token=:token"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
